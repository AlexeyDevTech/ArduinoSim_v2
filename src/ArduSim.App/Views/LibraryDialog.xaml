<Window x:Class="ArduSim.App.Views.LibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ArduSim.App.Localization"
        xmlns:v="clr-namespace:ArduSim.App.Views"
        xmlns:vm="clr-namespace:ArduSim.App.ViewModels"
        Title="ArduSim" Width="760" Height="600" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource Brush.Text.Primary}" FontFamily="{DynamicResource Font.Ui}" FontSize="{DynamicResource FontSize.Body}"
        Loaded="OnLoaded" Closing="OnClosing">
  <Window.Resources>
    <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <v:NullToVisibilityConverter x:Key="NullToVisibility" />
    <Style x:Key="Line.WhenText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Border Margin="0,0,12,12" Padding="20,16" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
          CornerRadius="{StaticResource Radius.Floating}" Effect="{DynamicResource Shadow}">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE711;" IsCancel="True" Click="OnClose" ToolTip="{l:Loc Dialog_Close}" />
        <TextBlock Text="{l:Loc Library_Title}" FontSize="{DynamicResource FontSize.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>

      <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
        <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="30,0,8,0" Height="30" />
        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE721;" HorizontalAlignment="Left" Margin="9,0,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" IsHitTestVisible="False" />
        <TextBlock Text="{l:Loc Library_Search}" Margin="33,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Hint}" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Query}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>

      <!-- The bottom first, so that the list takes what is left. -->
      <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
        <TextBlock Text="{l:Loc Library_Note}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{l:Loc Dialog_Close}" Click="OnClose" Padding="14,0" Margin="8,0,0,0" />
          <Button Content="{l:Loc Library_AddFolder}" Command="{Binding AddFolderCommand}" ToolTip="{l:Loc Library_AddFolderTip}" Padding="12,0" Margin="0,0,8,0" />
          <Button Content="{l:Loc Library_AddZip}" Command="{Binding AddZipCommand}" ToolTip="{l:Loc Library_AddZipTip}" Padding="12,0" HorizontalAlignment="Left" />
        </DockPanel>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom">
        <TextBlock Text="{Binding Message}" Style="{StaticResource Line.WhenText}" Foreground="{DynamicResource Brush.Accent}" />
        <TextBlock Text="{Binding Error}" Style="{StaticResource Line.WhenText}" Foreground="{DynamicResource Brush.Error}" />
      </StackPanel>

      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" MinHeight="24">
        <Button DockPanel.Dock="Right" Content="{l:Loc Library_Cancel}" Command="{Binding CancelCommand}" Padding="10,0" MinHeight="24" Height="24"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Width="24" Height="24" MinHeight="24" FontSize="12" Content="&#xE72C;" Command="{Binding RefreshCatalogCommand}" ToolTip="{l:Loc Library_Refresh}" />
        <TextBlock Text="{Binding Progress}" Style="{StaticResource Caption}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" DockPanel.Dock="Right" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>

      <TextBlock DockPanel.Dock="Top" Text="{Binding ListNote}" Style="{StaticResource Line.WhenText}" Margin="0,0,0,6" />

      <ListBox ItemsSource="{Binding Rows}" Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Border}" Foreground="{DynamicResource Brush.Text.Primary}"
               HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:LibraryRow}">
            <DockPanel Margin="4,6">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Width="96" Height="26" Margin="0,0,6,0" ToolTip="{l:Loc Library_VersionTip}" />
                <Button Content="{Binding ActionLabel}" Width="96" Height="26" MinHeight="26" Padding="6,0" IsEnabled="{Binding CanInstall}"
                        Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                <Button Style="{StaticResource Button.Icon}" Width="26" Height="26" MinHeight="26" FontSize="12" Content="&#xE74D;" Margin="4,0,0,0" ToolTip="{l:Loc Library_RemoveTip}"
                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Sentence}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Small}" Margin="0,2,0,0" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Size, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Author, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Line.WhenText}" Foreground="{DynamicResource Brush.Accent}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Note}" Style="{StaticResource Line.WhenText}" Foreground="{DynamicResource Brush.Warning}" Margin="0,2,0,0" />
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</Window>
