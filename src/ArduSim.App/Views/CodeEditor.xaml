<UserControl x:Class="ArduSim.App.Views.CodeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:l="clr-namespace:ArduSim.App.Localization"
             xmlns:vm="clr-namespace:ArduSim.App.ViewModels"
             xmlns:v="clr-namespace:ArduSim.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CodeDocumentViewModel}">
  <UserControl.Resources>
    <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <DockPanel Background="{DynamicResource Brush.Canvas}">
    <!-- Conflict bar: only when the file changed on disk and in the editor (docs/UI.md §2.5). -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
            Padding="12,6" Visibility="{Binding HasConflict, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{l:Loc Editor_Reload}" Command="{Binding ReloadFromDiskCommand}" ToolTip="{l:Loc Editor_ReloadTip}" Margin="0" />
        <Button DockPanel.Dock="Right" Content="{l:Loc Editor_KeepMine}" Command="{Binding KeepMineCommand}" Style="{StaticResource Button.Primary}" />
        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,8,0" />
        <TextBlock Text="{Binding ConflictText}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <!-- Replace (Ctrl+H): works with what the find bar above the text searches for. -->
    <Border x:Name="ReplaceBar" DockPanel.Dock="Top" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,4" Visibility="Collapsed">
      <DockPanel>
        <TextBlock Text="{l:Loc Editor_ReplaceWith}" Style="{StaticResource Caption}" Margin="0,0,8,0" />
        <TextBox x:Name="ReplaceBox" Width="180" Height="24" FontFamily="{DynamicResource Font.Mono}" PreviewKeyDown="OnReplaceKey" />
        <Button Content="{l:Loc Editor_Replace}" Click="OnReplaceOne" Margin="8,0,0,0" MinHeight="24" />
        <Button Content="{l:Loc Editor_ReplaceAll}" Click="OnReplaceAll" MinHeight="24" />
        <TextBlock x:Name="ReplacedText" Style="{StaticResource Caption}" Margin="8,0,0,0" />
      </DockPanel>
    </Border>
    <Grid>
    <ae:TextEditor x:Name="Editor"
                   Document="{Binding Document}" IsReadOnly="{Binding IsReadOnly}"
                   FontFamily="{DynamicResource Font.Mono}" FontSize="13"
                   ShowLineNumbers="True" WordWrap="False"
                   Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}"
                   LineNumbersForeground="{DynamicResource Brush.Text.Hint}"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                   Padding="4,6,0,0" />
    <!-- Go to line (Ctrl+G, Ctrl+L): 20 or 20:14. -->
    <Border x:Name="GoToBar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,24,0" Padding="8" Visibility="Collapsed"
            Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="{StaticResource Radius.Floating}" Effect="{DynamicResource Shadow}">
      <StackPanel Width="160">
        <TextBlock x:Name="GoToHint" Style="{StaticResource Caption}" Margin="0,0,0,4" />
        <TextBox x:Name="GoToBox" Height="24" FontFamily="{DynamicResource Font.Mono}" PreviewKeyDown="OnGoToKey" />
        <TextBlock x:Name="GoToError" Text="{l:Loc Editor_GoToInvalid}" Foreground="{DynamicResource Brush.Error}" Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="Collapsed" />
      </StackPanel>
    </Border>
    </Grid>
  </DockPanel>
</UserControl>
