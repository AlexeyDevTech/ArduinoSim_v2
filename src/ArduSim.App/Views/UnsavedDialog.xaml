<Window x:Class="ArduSim.App.Views.UnsavedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ArduSim.App.Localization"
        Title="ArduSim" Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource Brush.Text.Primary}" FontFamily="{DynamicResource Font.Ui}" FontSize="{DynamicResource FontSize.Body}">
  <Border Margin="0,0,12,12" Padding="20,16" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
          CornerRadius="{StaticResource Radius.Floating}" Effect="{DynamicResource Shadow}">
    <StackPanel>
      <TextBlock x:Name="Heading" FontSize="{DynamicResource FontSize.Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
      <TextBlock Text="{l:Loc Dialog_UnsavedBody}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,20" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{l:Loc Dialog_Save}" Style="{StaticResource Button.Primary}" IsDefault="True" Click="OnSave" Padding="14,0" />
        <Button Content="{l:Loc Dialog_Discard}" Click="OnDiscard" Padding="14,0" />
        <Button Content="{l:Loc Dialog_Cancel}" IsCancel="True" Click="OnCancel" Padding="14,0" Margin="0" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
