<UserControl x:Class="ArduSim.App.Views.SchematicCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ArduSim.App.ViewModels"
             xmlns:v="clr-namespace:ArduSim.App.Views"
             xmlns:l="clr-namespace:ArduSim.App.Localization"
             Focusable="True" FocusVisualStyle="{x:Null}" AllowDrop="True" ClipToBounds="True"
             Background="{DynamicResource Brush.Canvas}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ArduSim.App;component/Themes/Parts.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <v:PartTemplateSelector x:Key="PartTemplates" />
      <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Rectangle x:Name="GridLayer" IsHitTestVisible="False" />

    <!-- The world: everything in canvas units under one transform. Hit testing is done in code against the view model. -->
    <Canvas x:Name="World" IsHitTestVisible="False">
      <Canvas.RenderTransform>
        <MatrixTransform x:Name="WorldTransform" />
      </Canvas.RenderTransform>

      <ItemsControl ItemsSource="{Binding Parts}" ItemTemplateSelector="{StaticResource PartTemplates}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
              <Setter.Value>
                <TransformGroup>
                  <ScaleTransform ScaleX="{Binding FlipScale}" />
                  <RotateTransform Angle="{Binding Rotation}" />
                </TransformGroup>
              </Setter.Value>
            </Setter>
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ItemsControl>

      <ItemsControl ItemsSource="{Binding Wires}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:WireViewModel}">
            <Grid>
              <Polyline x:Name="Halo" Points="{Binding Points}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="6" Opacity="0"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              <Polyline x:Name="Line" Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeThickness="2.2"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Halo" Property="Opacity" Value="0.35" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Dimmed}" Value="True">
                <Setter TargetName="Line" Property="Opacity" Value="0.4" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Selection outlines and warning badges -->
      <ItemsControl ItemsSource="{Binding Parts}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding BoundsLeft}" />
            <Setter Property="Canvas.Top" Value="{Binding BoundsTop}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:PartViewModel}">
            <Canvas>
              <Rectangle x:Name="Outline" Canvas.Left="-3" Canvas.Top="-3" Width="{Binding OutlineWidth}" Height="{Binding OutlineHeight}"
                         Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1" RadiusX="2" RadiusY="2" Visibility="Collapsed" />
              <Rectangle x:Name="Flash" Canvas.Left="-3" Canvas.Top="-3" Width="{Binding OutlineWidth}" Height="{Binding OutlineHeight}"
                         Stroke="{DynamicResource Brush.Warning}" StrokeThickness="2" RadiusX="3" RadiusY="3" Visibility="Collapsed" />
              <Grid x:Name="Badge" Canvas.Left="{Binding BadgeLeft}" Canvas.Top="-8" Width="12" Height="11" Visibility="Collapsed">
                <Path Data="M 6,0 L 12,11 L 0,11 Z" Fill="{DynamicResource Brush.Warning}" />
                <TextBlock Text="!" FontSize="8" FontWeight="Bold" Foreground="#FF14161B" HorizontalAlignment="Center" Margin="0,2,0,0" />
              </Grid>
            </Canvas>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Outline" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Highlighted}" Value="True">
                <Setter TargetName="Flash" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding HasWarning}" Value="True">
                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ItemsControl ItemsSource="{Binding PinMarkers}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:PinMarker}">
            <Ellipse x:Name="Ring" Width="7" Height="7" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.2" Fill="#40101216" Margin="-3.5,-3.5,0,0" />
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsHot}" Value="True">
                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Brush.Accent}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ItemsControl ItemsSource="{Binding Corners}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:CornerHandle}">
            <Rectangle Width="5" Height="5" Margin="-2.5,-2.5,0,0" Fill="{DynamicResource Brush.Canvas}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Polyline Points="{Binding Ghost}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2" StrokeDashArray="3 2" Opacity="0.9" />
      <Rectangle x:Name="DropGhost" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1" StrokeDashArray="4 2" Visibility="Collapsed" />
    </Canvas>

    <!-- Screen-space overlays -->
    <Canvas IsHitTestVisible="False">
      <Rectangle x:Name="Marquee" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1" Fill="#182BC4A9" Visibility="Collapsed" />
      <Border x:Name="HoverTip" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
              CornerRadius="4" Padding="8,4" Visibility="Collapsed">
        <TextBlock x:Name="HoverText" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Primary}" />
      </Border>
      <Border x:Name="Hint" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1"
              CornerRadius="4" Padding="8,4" Visibility="Collapsed">
        <TextBlock Text="{l:Loc Canvas_LockedHint}" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Primary}" />
      </Border>
    </Canvas>

    <Border x:Name="ZoomBar" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Padding="4" CornerRadius="6"
            Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="ZoomButton" Click="OnZoomReset" Padding="8,2" Margin="0,0,4,0" ToolTip="Ctrl+9" />
        <Button Content="{l:Loc Canvas_Fit}" Click="OnFit" Padding="8,2" Margin="0" ToolTip="Ctrl+0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
