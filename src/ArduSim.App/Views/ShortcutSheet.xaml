<Window x:Class="ArduSim.App.Views.ShortcutSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ArduSim.App.Localization"
        Title="ArduSim" Width="460" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource Brush.Text.Primary}" FontFamily="{DynamicResource Font.Ui}" FontSize="{DynamicResource FontSize.Body}"
        PreviewKeyDown="OnKey">
  <!-- F1: every key and gesture, by context, with a filter. It does not block the window, so a key can be tried while it stays open. -->
  <Border Margin="12,0,0,0" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1,1,0,1" Effect="{DynamicResource Shadow}">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="20,12,8,8">
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE711;" Click="OnClose" ToolTip="{l:Loc Dialog_Close}" />
        <TextBlock Text="{l:Loc Shortcuts_Title}" FontSize="{DynamicResource FontSize.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <Grid DockPanel.Dock="Top" Margin="20,0,20,12">
        <TextBox x:Name="Filter" Height="28" Padding="6,0" TextChanged="OnFilterChanged" />
        <TextBlock x:Name="FilterHint" Text="{l:Loc Shortcuts_Filter}" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Hint}" IsHitTestVisible="False" />
      </Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,20,20">
        <ItemsControl x:Name="Groups" IsTabStop="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Items}" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,0,0,3">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Keys}" Width="176" TextWrapping="Wrap" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Text="{Binding Action}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
