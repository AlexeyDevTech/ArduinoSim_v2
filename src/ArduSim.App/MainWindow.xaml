<Window x:Class="ArduSim.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:ArduSim.App.Localization"
        xmlns:vm="clr-namespace:ArduSim.App.ViewModels"
        xmlns:v="clr-namespace:ArduSim.App.Views"
        xmlns:s="clr-namespace:ArduSim.App.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Width="1360" Height="860" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource FontSize.Body}"
        PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
    <KeyBinding Key="B" Modifiers="Control" Command="{Binding BuildCommand}" />
    <KeyBinding Key="F5" Command="{Binding RunCommand}" />
    <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding StopCommand}" />
    <KeyBinding Key="F6" Command="{Binding PauseCommand}" />
    <KeyBinding Key="F8" Command="{Binding NextDiagnosticCommand}" />
    <KeyBinding Key="F8" Modifiers="Shift" Command="{Binding PreviousDiagnosticCommand}" />
    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding TogglePaletteCommand}" />
    <KeyBinding Key="D2" Modifiers="Control" Command="{Binding TogglePropertiesCommand}" />
    <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ToggleBottomCommand}" />
    <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}" />
    <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}" />
  </Window.InputBindings>

  <Window.Resources>
    <v:EqualsToVisibilityConverter x:Key="IsVisibleWhen" />
    <v:NotEqualsToVisibilityConverter x:Key="IsHiddenWhen" />
    <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <v:BoolToVisibilityConverter x:Key="InvertBoolToVisibility" Invert="True" />
    <v:NullToVisibilityConverter x:Key="NullToVisibility" />
    <v:NullToVisibilityConverter x:Key="VisibleWhenNull" Invert="True" />
    <v:SameToVisibilityConverter x:Key="SameToVisibility" />
    <v:PositiveToVisibilityConverter x:Key="PositiveToVisibility" />
    <v:InvertBoolConverter x:Key="InvertBool" />

    <!-- Center tab headers -->
    <DataTemplate DataType="{x:Type vm:SceneTab}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE950;" Margin="0,0,8,0" />
        <TextBlock Text="{l:Loc Tab_Scene}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CodeDocumentViewModel}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Small}" VerticalAlignment="Center" />
        <TextBlock Text=" ●" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
        <Button Style="{StaticResource Button.Icon}" Width="20" Height="20" FontSize="10" Content="&#xE711;" Margin="6,0,-6,0"
                ToolTip="{l:Loc Tab_Close}" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
      </StackPanel>
    </DataTemplate>

    <!-- Project menu (the only menu, docs/UI.md §2.2) -->
    <ContextMenu x:Key="ProjectMenu">
      <MenuItem Header="{l:Loc Menu_New}" InputGestureText="Ctrl+N" Command="{Binding NewProjectCommand}" />
      <MenuItem Header="{l:Loc Menu_Open}" InputGestureText="Ctrl+O" Command="{Binding OpenProjectCommand}" />
      <MenuItem Header="{l:Loc Menu_Recent}" ItemsSource="{Binding Recent}" IsEnabled="{Binding CanEdit}">
        <MenuItem.ItemContainerStyle>
          <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Name}" />
            <Setter Property="ToolTip" Value="{Binding Path}" />
            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
          </Style>
        </MenuItem.ItemContainerStyle>
      </MenuItem>
      <MenuItem Header="{l:Loc Menu_Examples}" ItemsSource="{Binding Examples}" IsEnabled="{Binding CanEdit}">
        <MenuItem.ItemContainerStyle>
          <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Name}" />
            <Setter Property="Command" Value="{Binding DataContext.OpenExampleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
          </Style>
        </MenuItem.ItemContainerStyle>
      </MenuItem>
      <Separator />
      <MenuItem Header="{l:Loc Menu_Save}" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" IsEnabled="{Binding HasProject}" />
      <MenuItem Header="{l:Loc Menu_Reveal}" Command="{Binding RevealProjectCommand}" IsEnabled="{Binding HasProject}" />
      <MenuItem Header="{l:Loc Menu_CloseProject}" Command="{Binding CloseProjectCommand}" IsEnabled="{Binding HasProject}" />
      <Separator />
      <MenuItem Header="{l:Loc Menu_Settings}" Click="OnSettings" />
      <MenuItem Header="{l:Loc Menu_Accuracy}" Click="OnAccuracy" />
    </ContextMenu>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
      <RowDefinition Height="1" />
      <RowDefinition x:Name="BottomRow" Height="240" />
      <RowDefinition Height="24" />
    </Grid.RowDefinitions>

    <!-- ===== Title bar + toolbar, 48 px ===== -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" ToolTip="{l:Loc Window_Minimize}" Click="OnMinimize" />
          <Button x:Name="MaxButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" ToolTip="{l:Loc Window_Maximize}" Click="OnMaximize" />
          <Button Style="{StaticResource Button.Close}" Content="&#xE8BB;" ToolTip="{l:Loc Window_Close}" Click="OnCloseWindow" />
        </StackPanel>

        <!-- Clock and status, right-aligned before the window buttons -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource Button.Flat}" Command="{Binding ToggleClockCommand}" ToolTip="{l:Loc Toolbar_ClockTip}" MinWidth="88" Height="28">
            <TextBlock Text="{Binding VirtualTime}" FontFamily="{DynamicResource Font.Mono}" />
          </Button>
          <Button Command="{Binding ShowStatusPanelCommand}" Height="28" Padding="10,0" Margin="8,0,0,0" Background="{DynamicResource Brush.SurfaceRaised}">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Text.Secondary}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Status}" Value="Running">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Running}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Paused">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Busy">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Building">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="BuildFailed">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Error}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Crashed">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Error}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding StatusText}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
          <!-- App mark and project menu -->
          <Rectangle Width="12" Height="12" Fill="{DynamicResource Brush.Accent}" Margin="16,0,10,0" RadiusX="2" RadiusY="2" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
            <Rectangle.RenderTransform>
              <RotateTransform Angle="45" />
            </Rectangle.RenderTransform>
          </Rectangle>
          <Button x:Name="ProjectButton" Style="{StaticResource Button.Flat}" Height="32" Click="OnProjectMenu" ToolTip="{Binding ProjectDirectory}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="ArduSim" FontWeight="SemiBold" Visibility="{Binding HasProject, Converter={StaticResource InvertBoolToVisibility}}" />
              <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" MaxWidth="180" TextTrimming="CharacterEllipsis" />
              <TextBlock Text=" ●" Foreground="{DynamicResource Brush.Accent}" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" ToolTip="{l:Loc Toolbar_Unsaved}" />
              <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE70D;" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" />
            </StackPanel>
          </Button>
          <Rectangle Width="1" Height="24" Fill="{DynamicResource Brush.Border}" Margin="12,0" />

          <!-- Build and run -->
          <Button Style="{StaticResource Button.Flat}" Command="{Binding BuildCommand}" ToolTip="Ctrl+B" Height="32">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" Margin="0,0,6,0" />
              <TextBlock Text="{l:Loc Toolbar_Build}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Primary}" Command="{Binding RunCommand}" ToolTip="F5" Height="32" Margin="6,0,6,0" Padding="12,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,6,0" />
              <TextBlock Text="{l:Loc Toolbar_Run}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Flat}" Command="{Binding PauseCommand}" ToolTip="F6" Height="32" MinWidth="104">
            <Grid>
              <StackPanel Orientation="Horizontal" Visibility="{Binding IsPaused, Converter={StaticResource InvertBoolToVisibility}}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" Margin="0,0,6,0" />
                <TextBlock Text="{l:Loc Toolbar_Pause}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,6,0" />
                <TextBlock Text="{l:Loc Toolbar_Resume}" />
              </StackPanel>
            </Grid>
          </Button>
          <Button Style="{StaticResource Button.Flat}" Command="{Binding StopCommand}" ToolTip="Shift+F5" Height="32">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" Margin="0,0,6,0" />
              <TextBlock Text="{l:Loc Toolbar_Stop}" />
            </StackPanel>
          </Button>
          <Rectangle Width="1" Height="24" Fill="{DynamicResource Brush.Border}" Margin="8,0" />

          <!-- Step -->
          <Button Style="{StaticResource Button.Icon}" Content="&#xE8EE;" Command="{Binding StepLoopCommand}" ToolTip="{l:Loc Toolbar_StepLoopTip}" />
          <Button Style="{StaticResource Button.Flat}" Height="28" Padding="6,0" Command="{Binding StepTimeCommand}" CommandParameter="1" ToolTip="{l:Loc Toolbar_StepTip}">
            <TextBlock Text="{l:Loc Toolbar_Step1}" FontSize="{DynamicResource FontSize.Small}" />
          </Button>
          <Button Style="{StaticResource Button.Flat}" Height="28" Padding="6,0" Command="{Binding StepTimeCommand}" CommandParameter="10" ToolTip="{l:Loc Toolbar_StepTip}">
            <TextBlock Text="{l:Loc Toolbar_Step10}" FontSize="{DynamicResource FontSize.Small}" />
          </Button>
          <Button Style="{StaticResource Button.Flat}" Height="28" Padding="6,0" Command="{Binding StepTimeCommand}" CommandParameter="100" ToolTip="{l:Loc Toolbar_StepTip}">
            <TextBlock Text="{l:Loc Toolbar_Step100}" FontSize="{DynamicResource FontSize.Small}" />
          </Button>
          <Rectangle Width="1" Height="24" Fill="{DynamicResource Brush.Border}" Margin="8,0" />

          <!-- Speed and board -->
          <ComboBox ItemsSource="{Binding Speeds}" SelectedItem="{Binding SelectedSpeed}" MinWidth="76" ToolTip="{l:Loc Toolbar_Speed}" Margin="0,0,6,0">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SpeedOption}">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard}" MinWidth="120" ToolTip="{l:Loc Toolbar_Board}" IsEnabled="{Binding CanEdit}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Main area ===== -->
    <Grid x:Name="MainArea" Grid.Row="1" Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PaletteColumn" Width="240" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition x:Name="PropertiesColumn" Width="280" />
      </Grid.ColumnDefinitions>

      <!-- Palette -->
      <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}">
        <Grid>
          <DockPanel Visibility="{Binding PaletteOpen, Converter={StaticResource BoolToVisibility}}">
            <DockPanel DockPanel.Dock="Top" Height="36" Margin="12,0,4,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE76B;" FontSize="12" Command="{Binding TogglePaletteCommand}" ToolTip="{l:Loc Panel_CollapseTip1}" />
              <TextBlock Style="{StaticResource PanelHeader}" Text="{l:Loc Panel_Palette}" />
            </DockPanel>
            <Grid DockPanel.Dock="Top" Margin="12,0,12,8">
              <TextBox x:Name="PaletteSearch" Text="{Binding Palette.Search, UpdateSourceTrigger=PropertyChanged}" Padding="30,0,6,0" Height="28" />
              <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE721;" HorizontalAlignment="Left" Margin="9,0,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" IsHitTestVisible="False" />
              <TextBlock Text="{l:Loc Palette_Search}" Margin="31,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Disabled}" IsHitTestVisible="False"
                         Visibility="{Binding Palette.Search, Converter={StaticResource VisibleWhenNull}}" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
              <ItemsControl ItemsSource="{Binding Palette.Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:PaletteGroup}">
                    <StackPanel>
                      <ToggleButton Style="{StaticResource ToggleButton.Group}" Content="{Binding Name}" IsChecked="{Binding IsExpanded}" />
                      <ListBox Style="{StaticResource ListBox.Palette}" ItemsSource="{Binding Items}"
                               Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"
                               PreviewMouseLeftButtonDown="OnPaletteMouseDown" PreviewMouseMove="OnPaletteMouseMove"
                               MouseDoubleClick="OnPaletteDoubleClick" KeyDown="OnPaletteKeyDown">
                        <ListBox.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:PaletteItem}">
                            <TextBlock Text="{Binding Name}" ToolTip="{l:Loc Palette_ItemTip}" />
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
          <!-- Collapsed: a 24 px strip with a vertical label -->
          <Button Style="{StaticResource Button.Strip}" Command="{Binding TogglePaletteCommand}" ToolTip="Ctrl+1"
                  Visibility="{Binding PaletteOpen, Converter={StaticResource InvertBoolToVisibility}}">
            <TextBlock Text="{l:Loc Panel_Palette}">
              <TextBlock.LayoutTransform>
                <RotateTransform Angle="90" />
              </TextBlock.LayoutTransform>
            </TextBlock>
          </Button>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Vertical}" IsEnabled="{Binding PaletteOpen}" DragCompleted="OnSplitterDragCompleted" />

      <!-- Center: schematic and code tabs -->
      <Grid Grid.Column="2" Background="{DynamicResource Brush.Canvas}">
        <Grid.RowDefinitions>
          <RowDefinition Height="36" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal">
            <ListBox Style="{StaticResource ListBox.Tabs}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" />
            <Button x:Name="AddTabButton" Style="{StaticResource Button.Icon}" Content="&#xE710;" FontSize="12" Margin="4,0,0,0" ToolTip="{l:Loc Tab_OpenFile}" Click="OnAddTab" />
          </StackPanel>
        </Border>
        <Grid Grid.Row="1">
          <v:SchematicCanvas x:Name="Canvas" DataContext="{Binding Scene}"
                             Visibility="{Binding DataContext.IsSceneTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
          <ItemsControl ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Grid />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Resources>
              <DataTemplate DataType="{x:Type vm:SceneTab}" />
              <DataTemplate DataType="{x:Type vm:CodeDocumentViewModel}">
                <v:CodeEditor>
                  <v:CodeEditor.Visibility>
                    <MultiBinding Converter="{StaticResource SameToVisibility}">
                      <Binding />
                      <Binding Path="DataContext.SelectedTab" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                  </v:CodeEditor.Visibility>
                </v:CodeEditor>
              </DataTemplate>
            </ItemsControl.Resources>
          </ItemsControl>

          <!-- Banner: crash, busy firmware, toolchain download, runner exit -->
          <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,16,16,0" MaxWidth="720" Padding="16,12"
                  Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="{StaticResource Radius.Floating}"
                  Effect="{DynamicResource Shadow}"
                  Visibility="{Binding Banner, Converter={StaticResource IsHiddenWhen}, ConverterParameter=None}">
            <StackPanel>
              <TextBlock Text="{Binding BannerTitle}" FontSize="{DynamicResource FontSize.Title}" FontWeight="SemiBold" Margin="0,0,0,6" />
              <TextBlock Text="{Binding BannerBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <TextBox Style="{StaticResource TextBox.Output}" Text="{Binding BannerDetails, Mode=OneWay}" MaxHeight="220" Margin="0,0,0,10" TextWrapping="NoWrap"
                       Visibility="{Binding BannerDetails, Converter={StaticResource NullToVisibility}}" />
              <StackPanel Orientation="Horizontal">
                <Button Content="{l:Loc Banner_Rerun}" Command="{Binding RunCommand}" Style="{StaticResource Button.Primary}"
                        Visibility="{Binding Banner, Converter={StaticResource IsVisibleWhen}, ConverterParameter=Crash}" />
                <Button Content="{l:Loc Banner_OpenLine}" Command="{Binding OpenCrashLocationCommand}"
                        Visibility="{Binding HasCrashLocation, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{l:Loc Banner_Stop}" Command="{Binding StopCommand}" Style="{StaticResource Button.Primary}"
                        Visibility="{Binding Banner, Converter={StaticResource IsVisibleWhen}, ConverterParameter=Busy}" />
                <Button Content="{l:Loc Banner_Download}" Command="{Binding DownloadToolchainCommand}" Style="{StaticResource Button.Primary}"
                        Visibility="{Binding Banner, Converter={StaticResource IsVisibleWhen}, ConverterParameter=Toolchain}" />
                <Button Content="{l:Loc Banner_Close}" Command="{Binding CloseBannerCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <GridSplitter Grid.Column="3" Style="{StaticResource Splitter.Vertical}" IsEnabled="{Binding PropertiesOpen}" DragCompleted="OnSplitterDragCompleted" />

      <!-- Properties -->
      <Border Grid.Column="4" Background="{DynamicResource Brush.Surface}">
        <Grid>
          <DockPanel Visibility="{Binding PropertiesOpen, Converter={StaticResource BoolToVisibility}}" DataContext="{Binding Properties}">
            <DockPanel DockPanel.Dock="Top" Height="36" Margin="12,0,4,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE76C;" FontSize="12"
                      Command="{Binding DataContext.TogglePropertiesCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{l:Loc Panel_CollapseTip2}" />
              <TextBlock Style="{StaticResource PanelHeader}" Text="{l:Loc Panel_Properties}" />
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,12">
              <StackPanel>
                <!-- Header: id (editable for a part) and type -->
                <DockPanel Margin="0,0,0,12">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="8,0,0,0" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                  <Grid>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Mode, Converter={StaticResource IsHiddenWhen}, ConverterParameter=Part}" />
                    <TextBox Text="{Binding IdText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Font.Mono}" Height="28" KeyDown="OnIdKeyDown" LostKeyboardFocus="OnIdLostFocus"
                             IsEnabled="{Binding IsEditable}" ToolTip="{l:Loc Properties_IdTip}"
                             Visibility="{Binding Mode, Converter={StaticResource IsVisibleWhen}, ConverterParameter=Part}" />
                  </Grid>
                </DockPanel>
                <TextBlock Text="{Binding IdError}" Foreground="{DynamicResource Brush.Error}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,-8,0,8"
                           Visibility="{Binding IdError, Converter={StaticResource NullToVisibility}}" />

                <!-- Fields -->
                <ItemsControl ItemsSource="{Binding Fields}" IsEnabled="{Binding IsEditable}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PropertyField}">
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                          <Grid>
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Height="28" KeyDown="OnFieldKeyDown" LostKeyboardFocus="OnFieldLostFocus"
                                     Visibility="{Binding Editor, Converter={StaticResource IsVisibleWhen}, ConverterParameter=text}" />
                            <TextBox Text="{Binding Text, Mode=OneWay}" Height="28" IsReadOnly="True" PreviewKeyDown="OnKeyFieldKeyDown" ToolTip="{l:Loc Properties_KeyTip}"
                                     Visibility="{Binding Editor, Converter={StaticResource IsVisibleWhen}, ConverterParameter=key}" />
                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                      Visibility="{Binding Editor, Converter={StaticResource IsVisibleWhen}, ConverterParameter=dropdown}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OptionItem}">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ListBox Style="{StaticResource ListBox.Segmented}" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" HorizontalAlignment="Left"
                                     Visibility="{Binding Editor, Converter={StaticResource IsVisibleWhen}, ConverterParameter=segmented}">
                              <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OptionItem}">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                            <ListBox Style="{StaticResource ListBox.Swatches}" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                     Visibility="{Binding Editor, Converter={StaticResource IsVisibleWhen}, ConverterParameter=swatches}" />
                          </Grid>
                        </DockPanel>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Error}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Wire color -->
                <StackPanel Visibility="{Binding Mode, Converter={StaticResource IsVisibleWhen}, ConverterParameter=Wire}" Margin="0,0,0,10">
                  <TextBlock Text="{l:Loc Properties_Color}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                  <ListBox Style="{StaticResource ListBox.Swatches}" ItemsSource="{Binding WireColors}" SelectedItem="{Binding WireColor}" IsEnabled="{Binding IsEditable}" />
                </StackPanel>

                <!-- Pins / wire ends -->
                <TextBlock Text="{l:Loc Properties_Pins}" Style="{StaticResource Caption}" Margin="0,4,0,4"
                           Visibility="{Binding Pins.Count, Converter={StaticResource PositiveToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Pins}" Margin="0,0,0,12">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PinRow}">
                      <DockPanel Height="24">
                        <TextBlock Text="{Binding Pin}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Small}" Width="64" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Connection}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Actions -->
                <WrapPanel IsEnabled="{Binding IsEditable}">
                  <WrapPanel.Style>
                    <Style TargetType="WrapPanel">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode}" Value="Project">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </WrapPanel.Style>
                  <Button Command="{Binding RotateCommand}" ToolTip="R" Margin="0,0,6,6"
                          Visibility="{Binding Mode, Converter={StaticResource IsHiddenWhen}, ConverterParameter=Wire}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE7AD;" Margin="0,0,6,0" />
                      <TextBlock Text="{l:Loc Menu_Rotate}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding FlipCommand}" ToolTip="F" Margin="0,0,6,6"
                          Visibility="{Binding Mode, Converter={StaticResource IsHiddenWhen}, ConverterParameter=Wire}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE8AB;" Margin="0,0,6,0" />
                      <TextBlock Text="{l:Loc Menu_Flip}" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource Button.Icon}" Command="{Binding DeleteCommand}" Content="&#xE74D;" ToolTip="{l:Loc Menu_Delete}" Margin="0,0,6,6"
                          BorderBrush="{DynamicResource Brush.Border}" />
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
          <Button Style="{StaticResource Button.Strip}" Command="{Binding TogglePropertiesCommand}" ToolTip="Ctrl+2"
                  Visibility="{Binding PropertiesOpen, Converter={StaticResource InvertBoolToVisibility}}">
            <TextBlock Text="{l:Loc Panel_Properties}">
              <TextBlock.LayoutTransform>
                <RotateTransform Angle="90" />
              </TextBlock.LayoutTransform>
            </TextBlock>
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== Start view (no project open, docs/UI.md §2.7) ===== -->
    <ScrollViewer Grid.Row="1" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.Background}"
                  Visibility="{Binding HasProject, Converter={StaticResource InvertBoolToVisibility}}">
      <StackPanel MaxWidth="880" Margin="48,56,48,48">
        <TextBlock Text="ArduSim" FontSize="{DynamicResource FontSize.Display}" FontWeight="SemiBold" />
        <TextBlock Text="{l:Loc Start_Tagline}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,24" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,40">
          <Button Style="{StaticResource Button.Primary}" Command="{Binding NewProjectCommand}" Height="36" Padding="16,0" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
              <TextBlock Text="{l:Loc Start_New}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding OpenProjectCommand}" Height="36" Padding="16,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0" />
              <TextBlock Text="{l:Loc Start_Open}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="3*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="{l:Loc Start_Recent}" Style="{StaticResource PanelHeader}" Margin="0,0,0,12" />
            <TextBlock Text="{l:Loc Start_NoRecent}" Foreground="{DynamicResource Brush.Text.Secondary}"
                       Visibility="{Binding Recent.Count, Converter={StaticResource IsVisibleWhen}, ConverterParameter=0}" />
            <ItemsControl ItemsSource="{Binding Recent}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type s:RecentProject}">
                  <Button Style="{StaticResource Button.Flat}" HorizontalContentAlignment="Stretch" Padding="8,6" Margin="-8,0,0,2"
                          Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                    <StackPanel HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="{l:Loc Start_Examples}" Style="{StaticResource PanelHeader}" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding Examples}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ExampleItem}">
                  <Button Width="156" Margin="0,0,12,12" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                          Command="{Binding DataContext.OpenExampleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                    <StackPanel>
                      <!-- Thumbnail of the example's scene (rendered at idle); the icon shows until it arrives. -->
                      <Border Height="{x:Static v:ExampleThumbnails.Height}" Margin="1,1,1,0" CornerRadius="5,5,0,0" Background="{DynamicResource Brush.Canvas}"
                              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" ClipToBounds="True">
                        <Grid>
                          <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" Foreground="{DynamicResource Brush.Accent}" />
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                        </Grid>
                      </Border>
                      <TextBlock Text="{Binding Name}" Margin="10,6,10,8" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== Bottom panel ===== -->
    <GridSplitter x:Name="BottomSplitter" Grid.Row="2" Style="{StaticResource Splitter.Horizontal}" IsEnabled="{Binding BottomOpen}" DragCompleted="OnSplitterDragCompleted"
                  Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
    <Grid Grid.Row="3" Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
      <TabControl SelectedIndex="{Binding SelectedBottomTab}" Visibility="{Binding BottomOpen, Converter={StaticResource BoolToVisibility}}">
        <TabControl.Tag>
          <Button Style="{StaticResource Button.Icon}" Content="&#xE70D;" FontSize="12" Command="{Binding ToggleBottomCommand}" ToolTip="{l:Loc Panel_CollapseTip3}" />
        </TabControl.Tag>
        <TabItem Header="{l:Loc Tab_Serial}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="{l:Loc Serial_Send}" Command="{Binding SendSerialCommand}" Margin="8,0,0,0" />
              <ListBox DockPanel.Dock="Right" Style="{StaticResource ListBox.Segmented}" ItemsSource="{Binding LineEndings}" SelectedItem="{Binding SelectedLineEnding}" Margin="8,0,0,0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:LineEndingOption}">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock DockPanel.Dock="Right" Text="{l:Loc Serial_LineEnding}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
              <TextBox Text="{Binding SerialInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Font.Mono}" Height="28" KeyDown="OnSerialInputKeyDown" />
            </DockPanel>
            <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" Width="150">
              <TextBlock Text="{Binding BaudText}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
              <CheckBox Content="{l:Loc Serial_AutoScroll}" IsChecked="{Binding AutoScroll}" Margin="0,0,0,8" />
              <Button Content="{l:Loc Serial_Clear}" Command="{Binding ClearSerialCommand}" HorizontalAlignment="Left" />
            </StackPanel>
            <TextBox x:Name="SerialOutput" Style="{StaticResource TextBox.Output}" Text="{Binding SerialText, Mode=OneWay}" TextChanged="OnSerialTextChanged" />
          </DockPanel>
        </TabItem>
        <TabItem Header="{l:Loc Tab_Plotter}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" Width="150">
              <TextBlock Text="{l:Loc Plotter_Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <Button Command="{Binding Plotter.TogglePauseCommand}" HorizontalAlignment="Left" Margin="0,0,0,8">
                <Grid>
                  <TextBlock Text="{l:Loc Toolbar_Pause}" Visibility="{Binding Plotter.Paused, Converter={StaticResource InvertBoolToVisibility}}" />
                  <TextBlock Text="{l:Loc Toolbar_Resume}" Visibility="{Binding Plotter.Paused, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
              </Button>
              <Button Content="{l:Loc Serial_Clear}" Command="{Binding Plotter.ClearCommand}" HorizontalAlignment="Left" />
            </StackPanel>
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" ClipToBounds="True">
              <v:PlotterView Plotter="{Binding Plotter}" Version="{Binding Plotter.Version}" />
            </Border>
          </DockPanel>
        </TabItem>
        <TabItem Header="{l:Loc Tab_Build}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox Grid.Column="0" ItemsSource="{Binding Diagnostics}" Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Border}"
                     Foreground="{DynamicResource Brush.Text.Primary}" HorizontalContentAlignment="Stretch" KeyDown="OnDiagnosticKeyDown">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DiagnosticItem}">
                  <DockPanel Cursor="Hand" MouseLeftButtonUp="OnDiagnosticClick">
                    <TextBlock DockPanel.Dock="Left" FontFamily="{DynamicResource Font.Icons}" FontSize="12" Margin="0,2,8,0" VerticalAlignment="Top"
                               Style="{StaticResource Text.Severity}">
                      <TextBlock.Text>
                        <Binding Path="Severity">
                          <Binding.Converter>
                            <v:SeverityToGlyphConverter />
                          </Binding.Converter>
                        </Binding>
                      </TextBlock.Text>
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Location}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Small}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Small}" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBox Grid.Column="2" Style="{StaticResource TextBox.Output}" Text="{Binding BuildOutput, Mode=OneWay}" />
          </Grid>
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{l:Loc Tab_Log}" />
              <Border Style="{StaticResource Badge}" Visibility="{Binding UnseenWarnings, Converter={StaticResource PositiveToVisibility}}">
                <TextBlock Text="{Binding UnseenWarnings}" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.OnAccent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
              </Border>
            </StackPanel>
          </TabItem.Header>
          <ListBox ItemsSource="{Binding Log}" Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Border}" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:LogItem}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="{l:Loc Log_Show}" Padding="8,0" MinHeight="22" Margin="8,0,0,0"
                          Command="{Binding DataContext.ShowPartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding ComponentId}"
                          Visibility="{Binding ComponentId, Converter={StaticResource NullToVisibility}}" />
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Small}"
                             Foreground="{DynamicResource Brush.Text.Secondary}" Width="90" />
                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Style="{StaticResource Text.Severity}" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
      </TabControl>
      <!-- Collapsed: a strip with the tab names -->
      <Border Background="{DynamicResource Brush.Surface}" Visibility="{Binding BottomOpen, Converter={StaticResource InvertBoolToVisibility}}">
        <DockPanel Margin="8,0">
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE70E;" FontSize="12" Command="{Binding ToggleBottomCommand}" ToolTip="Ctrl+3" />
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Button.Flat}" Content="{l:Loc Tab_Serial}" Click="OnOpenBottomTab" Tag="0" Foreground="{DynamicResource Brush.Text.Secondary}" />
            <Button Style="{StaticResource Button.Flat}" Content="{l:Loc Tab_Plotter}" Click="OnOpenBottomTab" Tag="1" Foreground="{DynamicResource Brush.Text.Secondary}" />
            <Button Style="{StaticResource Button.Flat}" Content="{l:Loc Tab_Build}" Click="OnOpenBottomTab" Tag="2" Foreground="{DynamicResource Brush.Text.Secondary}" />
            <Button Style="{StaticResource Button.Flat}" Click="OnOpenBottomTab" Tag="3" Foreground="{DynamicResource Brush.Text.Secondary}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:Loc Tab_Log}" />
                <Border Style="{StaticResource Badge}" Visibility="{Binding UnseenWarnings, Converter={StaticResource PositiveToVisibility}}">
                  <TextBlock Text="{Binding UnseenWarnings}" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.OnAccent}" HorizontalAlignment="Center" />
                </Border>
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Toast (bottom-right, 3 s) -->
    <Border Grid.Row="1" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Padding="14,8" IsHitTestVisible="False"
            Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="{StaticResource Radius.Floating}"
            Effect="{DynamicResource Shadow}" Visibility="{Binding Toast, Converter={StaticResource NullToVisibility}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE73E;" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
        <TextBlock Text="{Binding Toast}" />
      </StackPanel>
    </Border>

    <!-- ===== Status bar, 24 px ===== -->
    <Border Grid.Row="4" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding ActualSpeed}" Style="{StaticResource Caption}" FontFamily="{DynamicResource Font.Mono}" Margin="12,0,0,0" />
        <TextBlock DockPanel.Dock="Right" Text="{l:Loc Inproc_Badge}" Foreground="{DynamicResource Brush.Warning}" FontSize="{DynamicResource FontSize.Small}" VerticalAlignment="Center"
                   Visibility="{Binding InProcess, Converter={StaticResource BoolToVisibility}}" />
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding ProjectDirectory}" Style="{StaticResource Caption}" MaxWidth="420" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="  ·  " Style="{StaticResource Caption}" Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding SelectedBoard.DisplayName}" Style="{StaticResource Caption}" Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="  ·  " Style="{StaticResource Caption}" Visibility="{Binding LastBuild, Converter={StaticResource NullToVisibility}}" />
          <TextBlock Text="{Binding LastBuild}" Style="{StaticResource Caption}" />
          <TextBlock Text="  ·  " Style="{StaticResource Caption}" Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding ToolchainText}" Style="{StaticResource Caption}" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
