<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ArduSim.App.ViewModels"
                    xmlns:v="clr-namespace:ArduSim.App.Views">
  <!-- Part drawings in canvas units (0.01 inch), keyed "Part.<type>" (docs/UI.md §3.6). Input is handled by SchematicCanvas. -->
  <v:ColorToBrushConverter x:Key="ColorToBrush" />
  <v:FrequencyConverter x:Key="Frequency" />
  <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <SolidColorBrush x:Key="Lead" Color="#FFB4BAC4" />

  <!-- Character LCD: green PCB, black bezel, the glass as a nearest-neighbor bitmap; parallel header on top or the I2C backpack at the left. -->
  <DataTemplate x:Key="Part.lcd" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="{Binding Width}" Height="{Binding Height}">
      <Rectangle Width="{Binding Width}" Height="{Binding Height}" RadiusX="4" RadiusY="4" Fill="#FF1E6B3C" Stroke="#FF15502C" />
      <Ellipse Canvas.Left="5" Canvas.Top="5" Width="9" Height="9" Fill="#FF0E1A12" Stroke="#FFC9A33A" />
      <Ellipse Canvas.Left="{Binding HoleRight}" Canvas.Top="5" Width="9" Height="9" Fill="#FF0E1A12" Stroke="#FFC9A33A" />
      <Ellipse Canvas.Left="5" Canvas.Top="{Binding HoleBottom}" Width="9" Height="9" Fill="#FF0E1A12" Stroke="#FFC9A33A" />
      <Ellipse Canvas.Left="{Binding HoleRight}" Canvas.Top="{Binding HoleBottom}" Width="9" Height="9" Fill="#FF0E1A12" Stroke="#FFC9A33A" />
      <Border Canvas.Left="{Binding BezelLeft}" Canvas.Top="{Binding BezelTop}" Width="{Binding BezelWidth}" Height="{Binding BezelHeight}"
              Background="#FF151617" CornerRadius="2" Padding="8">
        <Image Source="{Binding Screen}" Width="{Binding ScreenWidth}" Height="{Binding ScreenHeight}" Stretch="Fill"
               HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" />
      </Border>
      <!-- The PCF8574 backpack behind the module: only its edge with the four pins shows. -->
      <Rectangle Canvas.Left="-6" Canvas.Top="{Binding BackpackTop}" Width="12" Height="50" RadiusX="1.5" RadiusY="1.5" Fill="#FF1C3E8A" Stroke="#FF132B60"
                 Visibility="{Binding IsI2c, Converter={StaticResource BoolToVisibility}}" />
      <ItemsControl ItemsSource="{Binding Pins}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:PinViewModel}">
            <Canvas>
              <Ellipse Canvas.Left="-3" Canvas.Top="-3" Width="6" Height="6" Fill="#FF111317" Stroke="#FFD9B45A" StrokeThickness="1.2" />
              <TextBlock x:Name="Label" Canvas.Left="-10" Canvas.Top="4" Width="20" TextAlignment="Center" FontSize="3.8" Foreground="#FFE3EAF6" Text="{Binding Label}" />
            </Canvas>
            <DataTemplate.Triggers>
              <!-- Backpack pins sit at the left edge: labels go to their right. -->
              <DataTrigger Binding="{Binding X}" Value="0">
                <Setter TargetName="Label" Property="Canvas.Left" Value="8" />
                <Setter TargetName="Label" Property="Canvas.Top" Value="-2.6" />
                <Setter TargetName="Label" Property="TextAlignment" Value="Left" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Canvas>
  </DataTemplate>

  <!-- OLED module: blue PCB, black glass, the picture as a nearest-neighbor bitmap with a soft glow; pins on the top edge. -->
  <DataTemplate x:Key="Part.oled" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="{Binding Width}" Height="{Binding Height}">
      <Rectangle Width="{Binding Width}" Height="{Binding Height}" RadiusX="3" RadiusY="3" Fill="#FF1B4C9C" Stroke="#FF133A78" />
      <Ellipse Canvas.Left="3" Canvas.Top="3" Width="6" Height="6" Fill="#FF0E1A30" Stroke="#FFC9A33A" StrokeThickness="0.8" />
      <Ellipse Canvas.Left="{Binding HoleRight}" Canvas.Top="3" Width="6" Height="6" Fill="#FF0E1A30" Stroke="#FFC9A33A" StrokeThickness="0.8" />
      <Border Canvas.Left="{Binding GlassLeft}" Canvas.Top="{Binding GlassTop}" Width="{Binding GlassWidth}" Height="{Binding GlassHeight}"
              Background="#FF0A0B0F" BorderBrush="#FF2A2D35" BorderThickness="0.6" CornerRadius="1.5">
        <Image Source="{Binding Screen}" Width="{Binding ScreenWidth}" Height="{Binding ScreenHeight}" Stretch="Fill"
               HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor">
          <Image.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.65" Color="{Binding GlowColor}" />
          </Image.Effect>
        </Image>
      </Border>
      <ItemsControl ItemsSource="{Binding Pins}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:PinViewModel}">
            <Canvas>
              <Ellipse Canvas.Left="-3" Canvas.Top="-3" Width="6" Height="6" Fill="#FF111317" Stroke="#FFD9B45A" StrokeThickness="1.2" />
              <TextBlock Canvas.Left="-10" Canvas.Top="4" Width="20" TextAlignment="Center" FontSize="3.8" Foreground="#FFE3EAF6" Text="{Binding Label}" />
            </Canvas>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Canvas>
  </DataTemplate>

  <DataTemplate x:Key="Part.board" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="180" Height="70">
      <Rectangle Width="180" Height="70" RadiusX="3" RadiusY="3" Fill="#FF1D5AA8" Stroke="#FF143F78" />
      <Rectangle Canvas.Left="-12" Canvas.Top="24" Width="24" Height="22" RadiusX="1" RadiusY="1" Fill="#FFB8BEC8" />
      <Rectangle Canvas.Left="72" Canvas.Top="24" Width="36" Height="22" Fill="#FF1E1F24" />
      <TextBlock Canvas.Left="74.5" Canvas.Top="32" FontSize="4.4" Foreground="#FF8A93A6" Text="ATmega328P" />
      <TextBlock Canvas.Left="120" Canvas.Top="30" FontSize="7" FontWeight="SemiBold" Foreground="#FFD8E2F4" Text="NANO" />
      <Rectangle Canvas.Left="30" Canvas.Top="38" Width="7" Height="4" Fill="#FF4A3410" />
      <Ellipse Canvas.Left="23.5" Canvas.Top="30" Width="20" Height="20" Opacity="{Binding OnboardLed}">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#C0FFA020" Offset="0" />
            <GradientStop Color="#00FFA020" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Rectangle Canvas.Left="30" Canvas.Top="38" Width="7" Height="4" Fill="#FFFFA020" Opacity="{Binding OnboardLed}" />
      <TextBlock Canvas.Left="31.5" Canvas.Top="43" FontSize="4" Foreground="White" Text="L" />
      <Rectangle Canvas.Left="44" Canvas.Top="38" Width="7" Height="4" Fill="#FF3AE06A" />
      <TextBlock Canvas.Left="43.5" Canvas.Top="43" FontSize="4" Foreground="White" Text="ON" />
      <ItemsControl ItemsSource="{Binding Pins}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:PinViewModel}">
            <Canvas>
              <Ellipse Canvas.Left="-3" Canvas.Top="-3" Width="6" Height="6" Fill="#FF111317" Stroke="#FFD9B45A" StrokeThickness="1.2" />
              <TextBlock Canvas.Left="-10" Canvas.Top="{Binding LabelOffset}" Width="20" TextAlignment="Center" FontSize="3.8" Foreground="#FFE3EAF6" Text="{Binding Label}" />
            </Canvas>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Canvas>
  </DataTemplate>

  <!-- ESP32 DevKit v1: USB on the left, the WROOM module with its antenna on the right (pins from Esp32DevKit.cs). -->
  <DataTemplate x:Key="Part.board.esp32-devkit-v1" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="230" Height="110">
      <Rectangle Width="230" Height="110" RadiusX="3" RadiusY="3" Fill="#FF20242B" Stroke="#FF101216" />
      <Rectangle Canvas.Left="-10" Canvas.Top="44" Width="22" Height="22" RadiusX="1" RadiusY="1" Fill="#FFB8BEC8" />
      <Rectangle Canvas.Left="80" Canvas.Top="22" Width="140" Height="66" RadiusX="2" RadiusY="2" Fill="#FFA8AEB8" Stroke="#FF7D838E" />
      <Path Canvas.Left="186" Canvas.Top="28" Stroke="#FFD9B45A" StrokeThickness="1.6" Data="M0,0 L0,48 L6,48 L6,6 L12,6 L12,48 L18,48 L18,6 L24,6 L24,54" />
      <TextBlock Canvas.Left="90" Canvas.Top="44" FontSize="8" FontWeight="SemiBold" Foreground="#FF2B2F36" Text="ESP32-WROOM-32" />
      <TextBlock Canvas.Left="20" Canvas.Top="49" FontSize="6" Foreground="#FFD8E2F4" Text="ESP32 DEVKIT V1" />
      <Rectangle Canvas.Left="40" Canvas.Top="70" Width="7" Height="4" Fill="#FF0F2A4D" />
      <Ellipse Canvas.Left="33.5" Canvas.Top="62" Width="20" Height="20" Opacity="{Binding OnboardLed}">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#C03E8BFF" Offset="0" />
            <GradientStop Color="#003E8BFF" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Rectangle Canvas.Left="40" Canvas.Top="70" Width="7" Height="4" Fill="#FF3E8BFF" Opacity="{Binding OnboardLed}" />
      <TextBlock Canvas.Left="40" Canvas.Top="75" FontSize="4" Foreground="White" Text="D2" />
      <Rectangle Canvas.Left="54" Canvas.Top="70" Width="7" Height="4" Fill="#FFE54848" />
      <TextBlock Canvas.Left="53" Canvas.Top="75" FontSize="4" Foreground="White" Text="PWR" />
      <!-- Wi-Fi state: grey off, amber connecting, green connected, blue access point. -->
      <Ellipse x:Name="WifiDot" Canvas.Left="172" Canvas.Top="76" Width="6" Height="6" Fill="#FF5A606E" />
      <TextBlock Canvas.Left="150" Canvas.Top="76" FontSize="4.5" Foreground="#FF2B2F36" Text="Wi-Fi" />
      <ItemsControl ItemsSource="{Binding Pins}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:PinViewModel}">
            <Canvas>
              <Ellipse Canvas.Left="-3" Canvas.Top="-3" Width="6" Height="6" Fill="#FF111317" Stroke="#FFD9B45A" StrokeThickness="1.2" />
              <TextBlock Canvas.Left="-10" Canvas.Top="{Binding LabelOffset}" Width="20" TextAlignment="Center" FontSize="3.8" Foreground="#FFE3EAF6" Text="{Binding Label}" />
            </Canvas>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Canvas>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding WifiState}" Value="1">
        <Setter TargetName="WifiDot" Property="Fill" Value="#FFF2C94C" />
      </DataTrigger>
      <DataTrigger Binding="{Binding WifiState}" Value="2">
        <Setter TargetName="WifiDot" Property="Fill" Value="#FF3AE06A" />
      </DataTrigger>
      <DataTrigger Binding="{Binding WifiState}" Value="3">
        <Setter TargetName="WifiDot" Property="Fill" Value="#FF3E8BFF" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <!-- NodeMCU v3: USB on the left, the ESP-12E module with its antenna on the right (pins from Esp8266Boards.cs). -->
  <DataTemplate x:Key="Part.board.nodemcu-v3" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="240" Height="120">
      <Rectangle Width="240" Height="120" RadiusX="3" RadiusY="3" Fill="#FF1E2025" Stroke="#FF101216" />
      <Rectangle Canvas.Left="-10" Canvas.Top="49" Width="22" Height="22" RadiusX="1" RadiusY="1" Fill="#FFB8BEC8" />
      <Rectangle Canvas.Left="40" Canvas.Top="42" Width="36" Height="36" Fill="#FF2B2F36" />
      <TextBlock Canvas.Left="44" Canvas.Top="57" FontSize="4.5" Foreground="#FF8A93A6" Text="CH340G" />
      <Rectangle Canvas.Left="120" Canvas.Top="24" Width="112" Height="72" RadiusX="2" RadiusY="2" Fill="#FF1D4E8F" />
      <Rectangle Canvas.Left="124" Canvas.Top="30" Width="74" Height="60" RadiusX="2" RadiusY="2" Fill="#FFA8AEB8" Stroke="#FF7D838E" />
      <Path Canvas.Left="204" Canvas.Top="32" Stroke="#FFD9B45A" StrokeThickness="1.6" Data="M0,0 L0,48 L6,48 L6,6 L12,6 L12,48 L18,48 L18,6 L24,6 L24,54" />
      <TextBlock Canvas.Left="133" Canvas.Top="52" FontSize="8" FontWeight="SemiBold" Foreground="#FF2B2F36" Text="ESP-12E" />
      <TextBlock Canvas.Left="84" Canvas.Top="54" FontSize="6" Foreground="#FFD8E2F4" Text="NodeMCU v3" />
      <Ellipse Canvas.Left="192.5" Canvas.Top="79.5" Width="20" Height="20" Opacity="{Binding OnboardLed}">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#C03E8BFF" Offset="0" />
            <GradientStop Color="#003E8BFF" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>      <Rectangle Canvas.Left="200" Canvas.Top="88" Width="5" Height="3" Fill="#FF3E8BFF" Opacity="{Binding OnboardLed}" />
      <Ellipse x:Name="WifiDot" Canvas.Left="210" Canvas.Top="87" Width="6" Height="6" Fill="#FF5A606E" />
      <ItemsControl ItemsSource="{Binding Pins}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:PinViewModel}">
            <Canvas>
              <Ellipse Canvas.Left="-3" Canvas.Top="-3" Width="6" Height="6" Fill="#FF111317" Stroke="#FFD9B45A" StrokeThickness="1.2" />
              <TextBlock Canvas.Left="-10" Canvas.Top="{Binding LabelOffset}" Width="20" TextAlignment="Center" FontSize="3.8" Foreground="#FFE3EAF6" Text="{Binding Label}" />
            </Canvas>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>    </Canvas>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding WifiState}" Value="1">
        <Setter TargetName="WifiDot" Property="Fill" Value="#FFF2C94C" />
      </DataTrigger>
      <DataTrigger Binding="{Binding WifiState}" Value="2">
        <Setter TargetName="WifiDot" Property="Fill" Value="#FF3AE06A" />
      </DataTrigger>
      <DataTrigger Binding="{Binding WifiState}" Value="3">
        <Setter TargetName="WifiDot" Property="Fill" Value="#FF3E8BFF" />
      </DataTrigger>
    </DataTemplate.Triggers>  </DataTemplate>

  <!-- Wemos D1 mini: USB on the left, the ESP-12F module on the right (pins from Esp8266Boards.cs). -->
  <DataTemplate x:Key="Part.board.wemos-d1-mini" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="140" Height="100">
      <Rectangle Width="140" Height="100" RadiusX="3" RadiusY="3" Fill="#FF1E5C9E" Stroke="#FF143F78" />
      <Rectangle Canvas.Left="-10" Canvas.Top="39" Width="20" Height="22" RadiusX="1" RadiusY="1" Fill="#FFB8BEC8" />
      <Rectangle Canvas.Left="52" Canvas.Top="20" Width="84" Height="60" RadiusX="2" RadiusY="2" Fill="#FFA8AEB8" Stroke="#FF7D838E" />
      <Path Canvas.Left="112" Canvas.Top="24" Stroke="#FFD9B45A" StrokeThickness="1.4" Data="M0,0 L0,40 L5,40 L5,5 L10,5 L10,40 L15,40 L15,5 L20,5 L20,46" />
      <TextBlock Canvas.Left="58" Canvas.Top="44" FontSize="7" FontWeight="SemiBold" Foreground="#FF2B2F36" Text="ESP-12F" />
      <TextBlock Canvas.Left="16" Canvas.Top="45" FontSize="5.5" Foreground="#FFD8E2F4" Text="D1 mini" />
      <Ellipse Canvas.Left="90.5" Canvas.Top="63.5" Width="20" Height="20" Opacity="{Binding OnboardLed}">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#C03E8BFF" Offset="0" />
            <GradientStop Color="#003E8BFF" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>      <Rectangle Canvas.Left="98" Canvas.Top="72" Width="5" Height="3" Fill="#FF3E8BFF" Opacity="{Binding OnboardLed}" />
      <Ellipse x:Name="WifiDot" Canvas.Left="122" Canvas.Top="70" Width="6" Height="6" Fill="#FF5A606E" />
      <ItemsControl ItemsSource="{Binding Pins}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:PinViewModel}">
            <Canvas>
              <Ellipse Canvas.Left="-3" Canvas.Top="-3" Width="6" Height="6" Fill="#FF111317" Stroke="#FFD9B45A" StrokeThickness="1.2" />
              <TextBlock Canvas.Left="-10" Canvas.Top="{Binding LabelOffset}" Width="20" TextAlignment="Center" FontSize="3.8" Foreground="#FFE3EAF6" Text="{Binding Label}" />
            </Canvas>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>    </Canvas>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding WifiState}" Value="1">
        <Setter TargetName="WifiDot" Property="Fill" Value="#FFF2C94C" />
      </DataTrigger>
      <DataTrigger Binding="{Binding WifiState}" Value="2">
        <Setter TargetName="WifiDot" Property="Fill" Value="#FF3AE06A" />
      </DataTrigger>
      <DataTrigger Binding="{Binding WifiState}" Value="3">
        <Setter TargetName="WifiDot" Property="Fill" Value="#FF3E8BFF" />
      </DataTrigger>
    </DataTemplate.Triggers>  </DataTemplate>
  <DataTemplate x:Key="Part.led" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="40" Height="70">
      <Line X1="10" Y1="40" X2="10" Y2="70" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="30" Y1="40" X2="30" Y2="66" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="30" Y1="66" X2="30" Y2="70" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Ellipse Canvas.Left="-20" Canvas.Top="-24" Width="80" Height="80" Opacity="{Binding Brightness}">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="{Binding LedColor}" Offset="0" />
            <GradientStop Color="Transparent" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Path Data="M 5,40 L 5,18 A 15,15 0 0 1 35,18 L 35,40 Z" Fill="{Binding LedColor, Converter={StaticResource ColorToBrush}}" Opacity="0.35" />
      <Path Data="M 5,40 L 5,18 A 15,15 0 0 1 35,18 L 35,40 Z" Fill="{Binding LedColor, Converter={StaticResource ColorToBrush}}" Opacity="{Binding Brightness}" />
      <Rectangle Canvas.Left="2" Canvas.Top="38" Width="36" Height="4" RadiusX="1" RadiusY="1" Fill="{Binding LedColor, Converter={StaticResource ColorToBrush}}" Opacity="0.6" />
      <TextBlock Canvas.Left="6" Canvas.Top="58" FontSize="6" Foreground="#FF8A93A6" Text="+" />
    </Canvas>
  </DataTemplate>

  <DataTemplate x:Key="Part.rgb-led" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="50" Height="80">
      <Line X1="10" Y1="48" X2="10" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="20" Y1="48" X2="20" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="30" Y1="48" X2="30" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="40" Y1="48" X2="40" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Ellipse Canvas.Left="-15" Canvas.Top="-20" Width="80" Height="80" Opacity="{Binding RgbIntensity}">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="{Binding RgbColor}" Offset="0" />
            <GradientStop Color="Transparent" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Path Data="M 6,48 L 6,22 A 19,19 0 0 1 44,22 L 44,48 Z" Fill="#55D8DCE6" />
      <Path Data="M 6,48 L 6,22 A 19,19 0 0 1 44,22 L 44,48 Z" Fill="{Binding RgbColor, Converter={StaticResource ColorToBrush}}" Opacity="{Binding RgbIntensity}" />
    </Canvas>
  </DataTemplate>

  <DataTemplate x:Key="Part.resistor" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="60" Height="20">
      <Line X1="0" Y1="10" X2="60" Y2="10" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Rectangle Canvas.Left="13" Canvas.Top="4" Width="34" Height="12" RadiusX="4" RadiusY="4" Fill="#FFD9C28E" />
      <Rectangle Canvas.Left="19" Canvas.Top="4" Width="2.5" Height="12" Fill="#FFC23B32" />
      <Rectangle Canvas.Left="25" Canvas.Top="4" Width="2.5" Height="12" Fill="#FFC23B32" />
      <Rectangle Canvas.Left="31" Canvas.Top="4" Width="2.5" Height="12" Fill="#FF6E4B2A" />
      <Rectangle Canvas.Left="40" Canvas.Top="4" Width="2.5" Height="12" Fill="#FFD4AF37" />
      <TextBlock Canvas.Left="0" Canvas.Top="-10" Width="60" TextAlignment="Center" FontSize="6" Foreground="#FF9BA3B4" Text="{Binding ResistanceText}" />
    </Canvas>
  </DataTemplate>

  <DataTemplate x:Key="Part.pushbutton" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="60" Height="60">
      <Line X1="10" Y1="52" X2="10" Y2="60" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="50" Y1="52" X2="50" Y2="60" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Rectangle Canvas.Left="4" Canvas.Top="4" Width="52" Height="48" RadiusX="3" RadiusY="3" Fill="#FF2A2E36" Stroke="#FF454B58" />
      <Ellipse x:Name="Cap" Canvas.Left="15" Canvas.Top="13" Width="30" Height="30" Fill="{Binding LedColor, Converter={StaticResource ColorToBrush}}"
               Stroke="#40000000" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform>
          <ScaleTransform />
        </Ellipse.RenderTransform>
      </Ellipse>
      <TextBlock Canvas.Left="6" Canvas.Top="-10" Width="48" TextAlignment="Center" FontSize="6" Foreground="#FF9BA3B4" Text="{Binding KeyLabel}" />
    </Canvas>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Pressed}" Value="True">
        <Setter TargetName="Cap" Property="RenderTransform">
          <Setter.Value>
            <ScaleTransform ScaleX="0.86" ScaleY="0.86" />
          </Setter.Value>
        </Setter>
        <Setter TargetName="Cap" Property="Opacity" Value="0.75" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate x:Key="Part.slide-switch" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="60" Height="40">
      <Line X1="10" Y1="28" X2="10" Y2="40" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="30" Y1="28" X2="30" Y2="40" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="50" Y1="28" X2="50" Y2="40" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Rectangle Canvas.Top="4" Width="60" Height="24" RadiusX="3" RadiusY="3" Fill="#FF2A2E36" Stroke="#FF454B58" />
      <Rectangle Canvas.Left="10" Canvas.Top="11" Width="40" Height="10" RadiusX="2" RadiusY="2" Fill="#FF15171C" />
      <Rectangle x:Name="Knob" Canvas.Left="10" Canvas.Top="9" Width="20" Height="14" RadiusX="2" RadiusY="2" Fill="#FFC9CED8" />
    </Canvas>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding SwitchRight}" Value="True">
        <Setter TargetName="Knob" Property="Canvas.Left" Value="30" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate x:Key="Part.potentiometer" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="60" Height="60">
      <Line X1="10" Y1="44" X2="10" Y2="60" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="30" Y1="44" X2="30" Y2="60" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="50" Y1="44" X2="50" Y2="60" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Rectangle Canvas.Left="4" Canvas.Top="4" Width="52" Height="42" RadiusX="3" RadiusY="3" Fill="#FF2F5E9E" />
      <Canvas Canvas.Left="30" Canvas.Top="25">
        <Ellipse Canvas.Left="-16" Canvas.Top="-16" Width="32" Height="32" Fill="#FFD7DBE3" Stroke="#FF8A93A6" />
        <Line X1="0" Y1="0" X2="0" Y2="-13" Stroke="#FF1E1F24" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
          <Line.RenderTransform>
            <RotateTransform Angle="{Binding KnobAngle}" />
          </Line.RenderTransform>
        </Line>
      </Canvas>
    </Canvas>
  </DataTemplate>

  <DataTemplate x:Key="Part.buzzer" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="50" Height="50">
      <Line X1="15" Y1="40" X2="15" Y2="50" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="35" Y1="40" X2="35" Y2="50" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Ellipse Canvas.Left="3" Canvas.Top="0" Width="44" Height="44" Fill="#FF1E1F24" Stroke="#FF454B58" />
      <Ellipse Canvas.Left="20" Canvas.Top="17" Width="10" Height="10" Fill="#FF0D0E11" />
      <TextBlock Canvas.Left="-10" Canvas.Top="-12" Width="70" TextAlignment="Center" FontSize="7" FontWeight="SemiBold"
                 Foreground="#FF2BC4A9" Text="{Binding Frequency, Converter={StaticResource Frequency}}" />
    </Canvas>
  </DataTemplate>

  <!-- ==== M8: inputs and sensors (ADR-011) ==== -->

  <!-- Keys of the keypad and the IR remote: one cap per KeyCapViewModel, laid out by the template's grid. -->
  <DataTemplate x:Key="KeyCap" DataType="{x:Type vm:KeyCapViewModel}">
    <Border x:Name="Cap" Margin="1.5" CornerRadius="2" Background="#FFE9ECF1" BorderBrush="#FF9BA3B4" BorderThickness="0.5">
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="#FF1E1F24" Text="{Binding Label}" />
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsAccent}" Value="True">
        <Setter TargetName="Cap" Property="Background" Value="#FFD9534F" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsDown}" Value="True">
        <Setter TargetName="Cap" Property="Background" Value="#FF2BC4A9" />
        <Setter TargetName="Cap" Property="Margin" Value="3" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate x:Key="RemoteKeyCap" DataType="{x:Type vm:KeyCapViewModel}">
    <Border x:Name="Cap" Margin="2" CornerRadius="5" Background="#FF3A3E48" BorderBrush="#FF15171C" BorderThickness="0.5">
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="6.5" FontWeight="SemiBold" Foreground="#FFE9ECF1" Text="{Binding Label}" />
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsAccent}" Value="True">
        <Setter TargetName="Cap" Property="Background" Value="#FFB23A36" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsDown}" Value="True">
        <Setter TargetName="Cap" Property="Background" Value="#FF2BC4A9" />
        <Setter TargetName="Cap" Property="Margin" Value="3.5" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- KY-040: blue module, the knob turns 18° per detent and sinks while its shaft is pressed. -->
  <DataTemplate x:Key="Part.rotary-encoder" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="60" Height="80">
      <Line X1="10" Y1="68" X2="10" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="20" Y1="68" X2="20" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="30" Y1="68" X2="30" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="40" Y1="68" X2="40" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="50" Y1="68" X2="50" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Rectangle Canvas.Left="2" Width="56" Height="70" RadiusX="3" RadiusY="3" Fill="#FF1F3F7A" Stroke="#FF15305E" />
      <Rectangle Canvas.Left="12" Canvas.Top="12" Width="36" Height="36" RadiusX="2" RadiusY="2" Fill="#FF2A2E36" />
      <Canvas x:Name="Knob" Canvas.Left="30" Canvas.Top="30">
        <Canvas.RenderTransform>
          <ScaleTransform />
        </Canvas.RenderTransform>
        <Ellipse Canvas.Left="-15" Canvas.Top="-15" Width="30" Height="30" Fill="#FF1E1F24" Stroke="#FF8A93A6" />
        <Canvas>
          <Canvas.RenderTransform>
            <RotateTransform Angle="{Binding EncoderAngle}" />
          </Canvas.RenderTransform>
          <Ellipse Canvas.Left="-10" Canvas.Top="-10" Width="20" Height="20" Fill="#FFC9CED8" />
          <Rectangle Canvas.Left="-1.5" Canvas.Top="-12" Width="3" Height="9" RadiusX="1" RadiusY="1" Fill="#FF1E1F24" />
        </Canvas>
      </Canvas>
      <TextBlock Canvas.Left="4" Canvas.Top="58" FontSize="4.5" Foreground="#FFE9ECF1" Text="CLK  DT  SW   +  GND" />
    </Canvas>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Pressed}" Value="True">
        <Setter TargetName="Knob" Property="RenderTransform">
          <Setter.Value>
            <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
          </Setter.Value>
        </Setter>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- 4x4 membrane keypad with its ribbon tail; the key held down shows pressed. -->
  <DataTemplate x:Key="Part.keypad" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="120" Height="150">
      <Rectangle Canvas.Left="15" Canvas.Top="128" Width="80" Height="16" Fill="#FF2A2E36" />
      <Line X1="20" Y1="140" X2="20" Y2="150" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="30" Y1="140" X2="30" Y2="150" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="40" Y1="140" X2="40" Y2="150" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="50" Y1="140" X2="50" Y2="150" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="60" Y1="140" X2="60" Y2="150" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="70" Y1="140" X2="70" Y2="150" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="80" Y1="140" X2="80" Y2="150" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="90" Y1="140" X2="90" Y2="150" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Rectangle Width="120" Height="130" RadiusX="4" RadiusY="4" Fill="#FF15171C" Stroke="#FF454B58" />
      <ItemsControl Canvas.Left="10" Canvas.Top="8" Width="100" Height="116" ItemsSource="{Binding KeyCaps}" ItemTemplate="{StaticResource KeyCap}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="4" Columns="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <TextBlock Canvas.Left="17" Canvas.Top="132" FontSize="4.5" Foreground="#FF9BA3B4" Text="R1 R2 R3 R4 C1 C2 C3 C4" />
    </Canvas>
  </DataTemplate>

  <!-- Analog joystick: the cap leans with the stick and sinks while pressed. -->
  <DataTemplate x:Key="Part.joystick" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="70" Height="80">
      <Line X1="10" Y1="68" X2="10" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="20" Y1="68" X2="20" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="30" Y1="68" X2="30" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="40" Y1="68" X2="40" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="50" Y1="68" X2="50" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Rectangle Canvas.Left="2" Width="66" Height="70" RadiusX="3" RadiusY="3" Fill="#FF1F2A44" Stroke="#FF151D30" />
      <Ellipse Canvas.Left="11" Canvas.Top="8" Width="48" Height="48" Fill="#FF15171C" Stroke="#FF454B58" />
      <Ellipse x:Name="Cap" Canvas.Left="{Binding CapLeft}" Canvas.Top="{Binding CapTop}" Width="30" Height="30" Fill="#FF3A3E48" Stroke="#FF8A93A6" RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform>
          <ScaleTransform />
        </Ellipse.RenderTransform>
      </Ellipse>
      <TextBlock Canvas.Left="5" Canvas.Top="59" FontSize="4.5" Foreground="#FFE9ECF1" Text="GND +5V VRx VRy SW" />
    </Canvas>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Pressed}" Value="True">
        <Setter TargetName="Cap" Property="RenderTransform">
          <Setter.Value>
            <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
          </Setter.Value>
        </Setter>
        <Setter TargetName="Cap" Property="Fill" Value="#FF2BC4A9" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- DHT22 (white) or DHT11 (blue) with its grille; the readings it reports sit above it. -->
  <DataTemplate x:Key="Part.dht" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="50" Height="80">
      <Line X1="10" Y1="62" X2="10" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="20" Y1="62" X2="20" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="30" Y1="62" X2="30" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="40" Y1="62" X2="40" Y2="80" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Rectangle x:Name="Body" Canvas.Left="4" Width="42" Height="62" RadiusX="2" RadiusY="2" Fill="#FFE9ECF1" Stroke="#FF9BA3B4" />
      <Canvas Canvas.Left="10" Canvas.Top="6">
        <Rectangle Width="30" Height="4" RadiusX="1" RadiusY="1" Fill="#FF6C7486" />
        <Rectangle Canvas.Top="7" Width="30" Height="4" RadiusX="1" RadiusY="1" Fill="#FF6C7486" />
        <Rectangle Canvas.Top="14" Width="30" Height="4" RadiusX="1" RadiusY="1" Fill="#FF6C7486" />
        <Rectangle Canvas.Top="21" Width="30" Height="4" RadiusX="1" RadiusY="1" Fill="#FF6C7486" />
        <Rectangle Canvas.Top="28" Width="30" Height="4" RadiusX="1" RadiusY="1" Fill="#FF6C7486" />
      </Canvas>
      <TextBlock x:Name="Model" Canvas.Left="4" Canvas.Top="46" Width="42" TextAlignment="Center" FontSize="6" FontWeight="SemiBold" Foreground="#FF1E1F24" Text="DHT22" />
      <TextBlock Canvas.Left="-25" Canvas.Top="-12" Width="100" TextAlignment="Center" FontSize="7" FontWeight="SemiBold" Foreground="#FF2BC4A9" Text="{Binding Readout}" />
    </Canvas>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsDht11}" Value="True">
        <Setter TargetName="Body" Property="Fill" Value="#FF3F7FD0" />
        <Setter TargetName="Body" Property="Stroke" Value="#FF2B5C99" />
        <Setter TargetName="Model" Property="Text" Value="DHT11" />
        <Setter TargetName="Model" Property="Foreground" Value="#FFE9ECF1" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- DS18B20 in its TO-92 case, flat face forward. -->
  <DataTemplate x:Key="Part.ds18b20" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="40" Height="50">
      <Line X1="10" Y1="30" X2="10" Y2="50" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="20" Y1="30" X2="20" Y2="50" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="30" Y1="30" X2="30" Y2="50" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Path Data="M 5,30 L 5,14 A 15,13 0 0 1 35,14 L 35,30 Z" Fill="#FF1E1F24" Stroke="#FF454B58" />
      <TextBlock Canvas.Left="5" Canvas.Top="16" Width="30" TextAlignment="Center" FontSize="4.5" Foreground="#FF9BA3B4" Text="18B20" />
      <TextBlock Canvas.Left="-30" Canvas.Top="-12" Width="100" TextAlignment="Center" FontSize="7" FontWeight="SemiBold" Foreground="#FF2BC4A9" Text="{Binding Readout}" />
    </Canvas>
  </DataTemplate>

  <!-- HC-SR04: blue board with its two transducers; the distance it measures sits above it. -->
  <DataTemplate x:Key="Part.hc-sr04" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="90" Height="50">
      <Line X1="30" Y1="38" X2="30" Y2="50" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="40" Y1="38" X2="40" Y2="50" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="50" Y1="38" X2="50" Y2="50" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="60" Y1="38" X2="60" Y2="50" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Rectangle Width="90" Height="38" RadiusX="2" RadiusY="2" Fill="#FF1F4E8C" Stroke="#FF153866" />
      <Ellipse Canvas.Left="4" Canvas.Top="2" Width="32" Height="32" Fill="#FFB4BAC4" Stroke="#FF6C7486" />
      <Ellipse Canvas.Left="9" Canvas.Top="7" Width="22" Height="22" Fill="#FF2A2E36" />
      <Ellipse Canvas.Left="54" Canvas.Top="2" Width="32" Height="32" Fill="#FFB4BAC4" Stroke="#FF6C7486" />
      <Ellipse Canvas.Left="59" Canvas.Top="7" Width="22" Height="22" Fill="#FF2A2E36" />
      <TextBlock Canvas.Left="36" Canvas.Top="4" Width="18" TextAlignment="Center" FontSize="4" Foreground="#FFE9ECF1" Text="HC-SR04" TextWrapping="Wrap" />
      <TextBlock Canvas.Left="26" Canvas.Top="29" FontSize="4" Foreground="#FFE9ECF1" Text="Vcc Trig Echo Gnd" />
      <TextBlock Canvas.Left="-5" Canvas.Top="-12" Width="100" TextAlignment="Center" FontSize="7" FontWeight="SemiBold" Foreground="#FF2BC4A9" Text="{Binding Readout}" />
    </Canvas>
  </DataTemplate>

  <!-- IR receiver (VS1838B): black case with its dome; the dome lights up while a frame comes in. -->
  <DataTemplate x:Key="Part.ir-receiver" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="40" Height="50">
      <Line X1="10" Y1="30" X2="10" Y2="50" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="20" Y1="30" X2="20" Y2="50" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Line X1="30" Y1="30" X2="30" Y2="50" Stroke="{StaticResource Lead}" StrokeThickness="1.5" />
      <Rectangle Canvas.Left="6" Canvas.Top="4" Width="28" Height="27" RadiusX="2" RadiusY="2" Fill="#FF1E1F24" Stroke="#FF454B58" />
      <Ellipse x:Name="Dome" Canvas.Left="12" Canvas.Top="8" Width="16" Height="16" Fill="#FF2A2E36" Stroke="#FF454B58" />
      <TextBlock Canvas.Left="2" Canvas.Top="-8" FontSize="4.5" Foreground="#FF9BA3B4" Text="OUT GND VCC" />
    </Canvas>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Receiving}" Value="True">
        <Setter TargetName="Dome" Property="Fill" Value="#FF8E2F5C" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- The kit's 21-key IR remote (no pins: it reaches every IR receiver by light). -->
  <DataTemplate x:Key="Part.ir-remote" DataType="{x:Type vm:PartViewModel}">
    <Canvas Width="80" Height="170">
      <Rectangle Width="80" Height="170" RadiusX="10" RadiusY="10" Fill="#FF1B1C20" Stroke="#FF454B58" />
      <Ellipse Canvas.Left="34" Canvas.Top="6" Width="12" Height="8" Fill="#FF3A2A44" Stroke="#FF5C4470" />
      <TextBlock Canvas.Top="16" Width="80" TextAlignment="Center" FontSize="4.5" Foreground="#FF6C7486" Text="NEC 0x00" />
      <ItemsControl Canvas.Left="8" Canvas.Top="28" Width="64" Height="133" ItemsSource="{Binding KeyCaps}" ItemTemplate="{StaticResource RemoteKeyCap}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="7" Columns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Canvas>
  </DataTemplate>
  <DataTemplate x:Key="Part.unknown" DataType="{x:Type vm:PartViewModel}">
    <Border Width="{Binding Width}" Height="{Binding Height}" BorderBrush="#FFF0B44C" BorderThickness="1" CornerRadius="3">
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="6" Foreground="#FFF0B44C" Text="{Binding Id, StringFormat='? {0}'}" />
    </Border>
  </DataTemplate>
</ResourceDictionary>
