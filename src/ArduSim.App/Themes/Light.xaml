<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Light theme tokens, docs/UI.md §3.1 (same keys as Dark.xaml). -->
  <Color x:Key="Color.Background">#FFF4F5F7</Color>
  <Color x:Key="Color.Canvas">#FFFAFBFC</Color>
  <Color x:Key="Color.CanvasGrid">#FFD9DDE3</Color>
  <Color x:Key="Color.Surface">#FFFFFFFF</Color>
  <Color x:Key="Color.SurfaceRaised">#FFFFFFFF</Color>
  <Color x:Key="Color.SurfaceHover">#FFECEEF2</Color>
  <Color x:Key="Color.Border">#FFDDE1E7</Color>
  <Color x:Key="Color.BorderStrong">#FFC5CBD4</Color>
  <Color x:Key="Color.Text.Primary">#FF1B1E25</Color>
  <Color x:Key="Color.Text.Secondary">#FF5C6372</Color>
  <Color x:Key="Color.Text.Disabled">#FFA3AAB6</Color>
  <Color x:Key="Color.Accent">#FF0B7A69</Color>
  <Color x:Key="Color.AccentHover">#FF0A6B5C</Color>
  <Color x:Key="Color.OnAccent">#FFFFFFFF</Color>
  <Color x:Key="Color.Running">#FF1E9E4A</Color>
  <Color x:Key="Color.Warning">#FF946200</Color>
  <Color x:Key="Color.Error">#FFC53030</Color>
  <Color x:Key="Color.CloseHover">#FFC42B1C</Color>

  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
  <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" />
  <SolidColorBrush x:Key="Brush.Text.Hint" Color="#FF697080" />
  <SolidColorBrush x:Key="Brush.BorderInput" Color="#FF8A92A0" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.Accent}" Opacity="0.16" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
  <SolidColorBrush x:Key="Brush.Running" Color="{StaticResource Color.Running}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
  <SolidColorBrush x:Key="Brush.CloseHover" Color="{StaticResource Color.CloseHover}" />
  <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#FFC5CBD4" />
  <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#FFA3AAB6" />

  <!-- Floating elements: 1 px border plus shadow 0 4 16 rgba(16,24,40,.12) (docs/UI.md §3.3). -->
  <DropShadowEffect x:Key="Shadow" Color="#FF101828" Opacity="0.12" BlurRadius="16" ShadowDepth="4" Direction="270" />

  <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <!-- Icons: the Windows Fluent icon font (Windows 10 falls back to MDL2), docs/DECISIONS.md. -->
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <sys:Double x:Key="FontSize.Caption">11</sys:Double>
  <sys:Double x:Key="FontSize.Small">12</sys:Double>
  <sys:Double x:Key="FontSize.Body">13</sys:Double>
  <sys:Double x:Key="FontSize.Title">15</sys:Double>
  <sys:Double x:Key="FontSize.Display">28</sys:Double>
  <CornerRadius x:Key="Radius.Control">6</CornerRadius>
  <CornerRadius x:Key="Radius.Floating">8</CornerRadius>
  <CornerRadius x:Key="Radius.Chip">4</CornerRadius>
</ResourceDictionary>
