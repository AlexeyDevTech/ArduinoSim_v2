<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Dark theme tokens. Interim palette for M2; the visual language is fixed in docs/UI.md before M3. -->
  <Color x:Key="Color.Background">#FF14161B</Color>
  <Color x:Key="Color.Canvas">#FF101216</Color>
  <Color x:Key="Color.CanvasGrid">#FF1C1F26</Color>
  <Color x:Key="Color.Surface">#FF1B1E25</Color>
  <Color x:Key="Color.SurfaceRaised">#FF232731</Color>
  <Color x:Key="Color.SurfaceHover">#FF2C313C</Color>
  <Color x:Key="Color.Border">#FF2C313C</Color>
  <Color x:Key="Color.Text.Primary">#FFE7E9EE</Color>
  <Color x:Key="Color.Text.Secondary">#FF9BA3B4</Color>
  <Color x:Key="Color.Text.Disabled">#FF5C6372</Color>
  <Color x:Key="Color.Accent">#FF2BC4A9</Color>
  <Color x:Key="Color.AccentHover">#FF3FD6BB</Color>
  <Color x:Key="Color.OnAccent">#FF0B1A17</Color>
  <Color x:Key="Color.Warning">#FFF0B44C</Color>
  <Color x:Key="Color.Error">#FFF0605A</Color>

  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
  <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />

  <!-- Canvas grid: a faint dot every 16 px. -->
  <DrawingBrush x:Key="Brush.CanvasGrid" Viewport="0,0,16,16" ViewportUnits="Absolute" TileMode="Tile" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,16,16" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Brush>
            <SolidColorBrush Color="#FF262A33" />
          </GeometryDrawing.Brush>
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="8,8" RadiusX="1" RadiusY="1" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <sys:Double x:Key="FontSize.Small">12</sys:Double>
  <sys:Double x:Key="FontSize.Body">13</sys:Double>
  <sys:Double x:Key="FontSize.Title">15</sys:Double>
  <sys:Double x:Key="FontSize.Display">32</sys:Double>
  <CornerRadius x:Key="Radius.Control">6</CornerRadius>
</ResourceDictionary>
