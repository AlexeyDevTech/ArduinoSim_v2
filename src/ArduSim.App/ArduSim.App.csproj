<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF UI. Talks to the simulation only through ISimulationSession (ArduSim.Ipc). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!-- Bundled examples open as copies (ADR-008). -->
  <ItemGroup>
    <None Include="..\..\examples\**\*" Exclude="..\..\examples\**\eeprom.bin" LinkBase="examples" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArduSim.Core\ArduSim.Core.csproj" />
    <ProjectReference Include="..\ArduSim.Boards\ArduSim.Boards.csproj" />
    <ProjectReference Include="..\ArduSim.Build\ArduSim.Build.csproj" />
    <ProjectReference Include="..\ArduSim.Ipc\ArduSim.Ipc.csproj" />
    <!-- Referenced for the in-process session (inproc dev switch) and so ArduSim.Runner.exe ships next to the app. -->
    <ProjectReference Include="..\ArduSim.Runner\ArduSim.Runner.csproj" />
  </ItemGroup>

</Project>
