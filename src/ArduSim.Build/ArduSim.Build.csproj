<Project Sdk="Microsoft.NET.Sdk">

  <!-- Toolchain manager, .ino preprocessor, library resolver, compiler driver, object cache. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArduSim.Build.Tests" />
  </ItemGroup>

  <!-- The shim and the bundled libraries travel with every executable that builds firmware. -->
  <ItemGroup>
    <None Include="..\..\firmware\**\*" Exclude="..\..\firmware\**\build\**" LinkBase="firmware" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\libraries\**\*" LinkBase="libraries" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
