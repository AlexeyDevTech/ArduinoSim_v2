<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console host: loads firmware.dll, runs Core, serves IPC, headless CLI. One process per run. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArduSim.Core\ArduSim.Core.csproj" />
    <ProjectReference Include="..\ArduSim.Boards\ArduSim.Boards.csproj" />
    <ProjectReference Include="..\ArduSim.Build\ArduSim.Build.csproj" />
    <ProjectReference Include="..\ArduSim.Ipc\ArduSim.Ipc.csproj" />
  </ItemGroup>

</Project>
